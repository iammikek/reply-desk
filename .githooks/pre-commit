#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

if [ ! -f vendor/bin/pint ]; then
    echo "Pint is not installed. Run composer install."
    exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')

if [ -z "$files" ]; then
    exit 0
fi

printf '%s\n' "$files" | while IFS= read -r file; do
    if [ -z "$file" ]; then
        continue
    fi

    vendor/bin/pint "$file"
    git add -- "$file"
done
